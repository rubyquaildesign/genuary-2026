{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*",
		".shader-data/**/*",
		"src/global.d.ts"
	],
	"compilerOptions": {
		"types": ["@webgpu/types"],
		"paths": {
			"$shader/*": ["./.shader-data/*"],
			"$components/*": ["./src/components/*"],
			"$scripts/*": ["./src/scripts/*"],
			"$artworks/*": ["./src/scripts/artworks/*"],
			"$styles/*": ["./src/styles/*"],
			"$assets/*": ["./src/assets/*"]
		}
	},
	"exclude": ["dist"]
}
