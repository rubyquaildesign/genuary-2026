---
export interface Props {
	classes: string[];
	strokeWidth?: number;
}
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	class={Astro.props.classes.join(' ')}
	viewBox="0 0 10 10"
  preserveAspectRatio="none"
>
	<line
		vector-effect="non-scaling-stroke"
		x1="0"
		x2="10"
		y1="5"
		y2="5"
		stroke="currentColor"
    stroke-linecap="round"
		stroke-width={(Astro.props.strokeWidth ?? 4).toString()}
	></line>
</svg>
